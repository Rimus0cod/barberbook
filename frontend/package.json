{
  "name": "barberbook-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "tsc --noEmit --pretty false",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:e2e": "npm run test:e2e:smoke",
    "test:e2e:smoke": "playwright test --config playwright.config.ts",
    "test:e2e:full": "sh ./scripts/test-e2e-full.sh",
    "test:e2e:full:playwright": "playwright test --config playwright.full.config.ts",
    "test:e2e:portfolio-screenshots": "E2E_SUITE=portfolio-screenshots sh ./scripts/test-e2e-full.sh",
    "test:e2e:portfolio-screenshots:playwright": "playwright test --config playwright.portfolio.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@tanstack/react-query": "^5.62.8",
    "axios": "^1.7.9",
    "dayjs": "^1.11.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^6.28.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
